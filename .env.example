GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Required production pilot configuration. Use persistent, absolute paths.
NODE_ENV=production
SHORTLET_PUBLIC_ORIGIN=https://pilot.example.com
SHORTLET_DB_PATH=/persistent/shortlet/shortlet.sqlite
SHORTLET_INVENTORY_PATH=/persistent/shortlet/inventory.json
SHORTLET_OPERATORS_PATH=/persistent/shortlet/operators.json
PAYSTACK_SECRET_KEY=
PAYSTACK_ENVIRONMENT=live

# Optional runtime settings.
PORT=3000
CONCIERGE_MODE=deterministic

# Test/development only: local fixture applications may use deterministic state
# and PSP behavior. Never use these settings for `npm run pilot:start`.
# PAYSTACK_ENVIRONMENT=test
# PAYSTACK_CALLBACK_BASE_URL=http://localhost:3001
# SHORTLET_DB_PATH=.scratch/local-guest/guest_fixture.sqlite
