# Required production pilot configuration. Use persistent, absolute paths.
NODE_ENV=production
SHORTLET_PUBLIC_ORIGIN=https://pilot.example.com
SHORTLET_DB_PATH=/persistent/shortlet/shortlet.sqlite
SHORTLET_INVENTORY_PATH=/persistent/shortlet/inventory.json
SHORTLET_OPERATORS_PATH=/persistent/shortlet/operators.json
PAYSTACK_SECRET_KEY=
PAYSTACK_ENVIRONMENT=live

# Closed beta only: staging takes Paystack test keys, shows a beta banner on every
# page and needs the invite code before a Guest session starts. Unset = production.
# SHORTLET_DEPLOYMENT=staging
# SHORTLET_BETA_INVITE_CODE=
# PAYSTACK_ENVIRONMENT=test

# Concierge. Unset or `deterministic` runs the rule-based concierge with no model.
# `gemini` or `openai-compatible` runs the AI concierge. Any other value fails startup.
CONCIERGE_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: minimal, low, medium or high.
# GEMINI_THINKING_LEVEL=low

# OpenAI-compatible provider: DeepSeek or OpenAI. Used as the primary with
# CONCIERGE_MODE=openai-compatible, or as the fallback when Gemini is unavailable
# (connection error, rate limit or server error) with CONCIERGE_FALLBACK below.
# For OpenAI use LLM_BASE_URL=https://api.openai.com/v1 and an OpenAI model.
# CONCIERGE_FALLBACK=openai-compatible
# LLM_PROVIDER_LABEL=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=

# Optional runtime settings.
PORT=3000

# Optional guardrails (defaults shown; see docs/pilot-deployment.md).
# SHORTLET_CHAT_TURNS_PER_SESSION_PER_HOUR=60
# SHORTLET_CHAT_TURNS_PER_ADDRESS_PER_HOUR=600
# SHORTLET_NEW_SESSIONS_PER_ADDRESS_PER_HOUR=120
# SHORTLET_OPERATOR_LOGINS_PER_ADDRESS_PER_HOUR=10
# CONCIERGE_DAILY_MODEL_CALL_CAP=3000
# SHORTLET_GUEST_RUNTIME_IDLE_MINUTES=30

# Test/development only: local fixture applications may use deterministic state
# and PSP behavior. Never use these settings for `npm run pilot:start`.
# PAYSTACK_ENVIRONMENT=test
# PAYSTACK_CALLBACK_BASE_URL=http://localhost:3001
# SHORTLET_DB_PATH=.scratch/local-guest/guest_fixture.sqlite
