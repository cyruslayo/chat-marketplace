            <span id="composer-hint" class="sr-only">Share a city or neighbourhood, dates or nights, and number of guests.</span>
            <button id="composer-submit" class="ui-button ui-button--primary" type="submit" aria-label="Send"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button>
            <p id="working-status" hidden></p>
            <button id="turn-cancel" class="ui-button ui-button--quiet ui-button--small" type="button" hidden>Cancel</button>
          </form>
        </main>
