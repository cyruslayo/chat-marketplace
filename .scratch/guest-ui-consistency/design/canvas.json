      "w": 520,
      "size": "m",
      "fill": "gray",
      "text": "Deadlines always use the one warning banner: absolute WAT time plus the time left. This replaces the blue 'Time left to pay' box the chat workspace shows today."
    },
    "payTitle": {
      "x": 0,
      "y": 6900,
