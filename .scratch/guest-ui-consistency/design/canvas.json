    "kitNote": {
      "x": -620,
      "y": 0,
      "w": 520,
      "size": "m",
      "fill": "teal",
      "text": "Every screen below uses only these components. The chat workspace and the standalone page show the SAME screen: same top bar, journey rail, stay ticket, price breakdown and deadline banner. Only the way you arrive differs (the chat opens it in the workspace; a link opens it as a page). Tokens come straight from apps/web/src/shortlet-foundations.css."
    },
    "discoverTitle": {
      "x": 0,
      "y": 1620,
      "text": "Discover",
      "kind": "title1",
      "maxW": 2270
    },
    "discoverNote": {
      "x": -620,
      "y": 1880,
      "w": 520,
      "size": "m",
      "fill": "gray",
      "text": "Chat and search share one stay card and one compact result row. The All-In Stay Total leads; the Refundable Security Deposit is always a separate line (ADR 0015). Location is neighbourhood-level; no ratings, badges or price-pin map (ADR 0066)."
    },
    "requestTitle": {
      "x": 0,
      "y": 3620,
      "text": "Request",
      "kind": "title1",
      "maxW": 1800
    },
    "requestNote": {
      "x": -620,
      "y": 3880,
      "w": 520,
      "size": "m",
      "fill": "gray",
      "text": "Before the owner accepts, nothing is payable: the breakdown carries the 'If your request is accepted' tag. The stay ticket is identical on every booking screen from here to confirmation."
    },
    "offerTitle": {
      "x": 0,
      "y": 5260,
      "text": "Offer",
      "kind": "title1",
      "maxW": 860
