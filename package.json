{
  "name": "chat-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "verify:weaver": "node scripts/verify-weaver-vendor.mjs",
    "owner:local": "tsx apps/local-owner/src/cli-start.ts",
    "owner:reset": "tsx apps/local-owner/src/cli-reset.ts",
    "pilot:start": "tsx apps/pilot/src/cli-start.ts",
    "pilot:local": "node apps/local-guest/scripts/build-client.mjs && tsx apps/pilot/src/cli-local-start.ts",
    "pilot:local:bootstrap": "tsx apps/pilot/src/cli-local-bootstrap.ts",
    "pilot:local:reset": "tsx apps/pilot/src/cli-local-reset.ts",
    "pilot:local:operator-token": "tsx apps/pilot/src/cli-local-operator-token.ts",
    "pilot:acceptance:rodney": "pwsh -NoProfile -File scripts/pilot-acceptance-rodney.ps1",
    "pilot:local:agent-smoke": "tsx scripts/pilot-agent-smoke.ts",
    "operator:provision": "tsx apps/local-owner/src/cli-provision.ts",
    "operator:revoke": "tsx apps/local-owner/src/cli-revoke.ts",
    "pilot:operator:create": "tsx apps/shortlet-ops/src/cli-operator-create.ts",
    "pilot:operator:list": "tsx apps/shortlet-ops/src/cli-operator-list.ts",
    "pilot:operator:update": "tsx apps/shortlet-ops/src/cli-operator-update.ts",
    "pilot:operator:bootstrap": "tsx apps/shortlet-ops/src/cli-operator-bootstrap.ts",
    "pilot:inventory:import": "tsx apps/shortlet-ops/src/cli-inventory-import.ts",
    "test:owner-local": "tsx --test test/local-apartment-owner-surface.test.ts",
    "guest:local": "node apps/local-guest/scripts/build-client.mjs && tsx apps/local-guest/src/cli-start.ts",
    "guest:assistant": "node apps/local-guest/scripts/build-client.mjs && tsx apps/local-guest/src/cli-assistant.ts",
    "guest:reset": "tsx apps/local-guest/src/cli-reset.ts",
    "test:guest-local": "tsx --test test/local-guest-weaver-demo.test.ts",
    "test:assistant": "node --import tsx --test test/assistant-interactions-protocol.test.ts test/shortlet-assistant-evals.test.ts",
    "assistant:preflight": "node --import tsx scripts/assistant-preflight.ts",
    "assistant:live-smoke": "node --import tsx scripts/assistant-live-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@weaver/core": "file:vendor/weaver/weaver-core-0.1.2.tgz",
    "@weaver/web": "file:vendor/weaver/weaver-web-0.1.2.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.2",
    "happy-dom": "20.11.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
